PORT=4000
# Requires Node >=22.13. Local SQLite is created automatically; no Docker required.
# DATABASE_PATH=/absolute/path/to/brightloop.sqlite
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional SMTP. Without SMTP, development emails are saved in backend/outbox.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Brightloop <billing@example.com>
# NODE_ENV=production
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_PASSWORD=Use-a-strong-password
